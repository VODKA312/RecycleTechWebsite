# RecycleTech 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 服务器配置
SERVER_HOST=your-server-ip
SERVER_USER=deploy
SERVER_PATH=/var/www/recycletech

# Django配置
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip

# 数据库配置
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/var/www/recycletech/db.sqlite3

# 域名配置
DOMAIN_NAME=your-domain.com
WWW_DOMAIN=www.your-domain.com

# 部署配置
DEPLOY_BACKUP_PATH=/var/backups/recycletech
DEPLOY_LOG_PATH=/var/log/recycletech 